# Rich Chat Client Configuration
# Copy this file to .env and modify as needed

# Basic Configuration
LANGUAGE=zh
LANGUAGE_PACK=../lang_pack/client/main.go
# SECURITY: Use https:// in production to protect credentials
URL_SCHEMA=http
URL_DOMAIN=localhost
URL_PORT=2316
# NOTE: URL_USERNAME and URL_PASSWORD are used for HTTP Basic Auth with server API
# In production, change these to match your server's Basic Auth credentials
URL_USERNAME=admin
URL_PASSWORD=password

# Application Configuration
CONFIG_DIR=config
CONFIG_FILE=config.json
USER_AGENT=rich_chat 1.0.0
ALLOW_MAX_LENGTH_OF_USERNAME=50